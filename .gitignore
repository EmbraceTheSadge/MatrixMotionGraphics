# Dependencies and caches — never commit
node_modules/
.npm/
.cache/
**/.cache/
ms-playwright/
pw-browsers/
*.log

# Model weights / large generated assets
models/
checkpoints/
*.safetensors
*.ckpt
*.pt
*.bin
*.onnx

# Intermediate render output (final deliverables go in outputs/)
renders/
frames/
tmp/
.hyperframes/

.DS_Store
Thumbs.db

# motion-studio machine-local state (written by setup.sh)
.claude/skills/motion-studio/.venv/
.claude/skills/motion-studio/.python
.claude/skills/motion-studio/.acestep

# HyperFrames project build products (regenerate: build_sfx.py, vendor_gsap.sh, snapshot)
videos/*/snapshots/
videos/*/assets/audio/*.wav
videos/*/assets/vendor/

__pycache__/
*.pyc
